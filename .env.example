# Free event API keys. Set at least one; the app skips any that are missing.

# Ticketmaster Discovery API: sign up at https://developer.ticketmaster.com,
# then copy the "Consumer Key" from My Apps.
TICKETMASTER_API_KEY=

# Skiddle (UK events): request a key at https://www.skiddle.com/api/join.php
SKIDDLE_API_KEY=

# Optional: search Instagram posts for grassroots events (see README).
# Your Instagram Business/Creator account ID and a Graph API token for it.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Comma-separated public Business/Creator accounts to read, e.g. local collectives and venues.
INSTAGRAM_ACCOUNTS=
# Comma-separated hashtags (max 30 different ones a week). Defaults to <city>events,<city>whatson.
INSTAGRAM_HASHTAGS=
